# Every environment variable of idp-agent's own, and the two its model SDK reads.
# It also honours the system's own: HOME (USERPROFILE on Windows),
# XDG_CONFIG_HOME (APPDATA on Windows), where the personal config.yml is,
# XDG_CACHE_HOME (else ~/.cache), where a catalogue read is kept, and
# NO_COLOR / FORCE_COLOR.
#
# The CLI never loads a .env file itself: it reads its environment. Copy this
# file to .env (git ignores it), set IDP_PROVIDER and IDP_MODEL, uncomment that
# provider's key line and fill it in, then hand the file to Node from the clone:
#
#   node --env-file=.env dist/cli/bin.js "which databases are in prod?" --demo
#
# or export the same variables in your shell for `idpa` anywhere. For a change,
# stand in the declarations repository instead and name the clone by path:
# from the clone, whose root holds a package.json, the Inspector would read
# idp-agent itself as the service (or pass --project).
#
# An empty value is unset for every variable idp-agent reads itself, not for
# the SDK's two below. graph, show, relations, validate, init platform and
# plan --from call no model and need none of the first two sections.
#
# `tests/unit/env-example.test.ts` fails when the code reads a variable this
# file does not list, or this file lists one nothing reads.

# --- The model: needed by idpa "<phrase>", ask, plan "<intent>" and init ------

# anthropic, mistral or openai. None is the default.
IDP_PROVIDER=
# The model id, as the provider names it. The tapes in tests/recordings were
# made with gpt-6-luna (openai) and mistral-small-2603 (mistral).
IDP_MODEL=

# The key, in the chosen provider's own variable; the other two stay unset. It
# is sent to that provider and nowhere else, and never enters a trace.
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# OPENAI_API_KEY=

# --- The model: optional --------------------------------------------------

# Seconds one model call may take, retries included. 120 when unset.
# IDP_TIMEOUT=120
# Another model of the same provider and key for the Supervisor, which only
# classifies a phrase as a question or a change. IDP_MODEL when unset.
# IDP_SUPERVISOR_MODEL=

# Read by the provider's SDK, not by idp-agent: each moves that provider's
# endpoint, and the key then goes to the URL it names. Leave these commented
# out unless you route through a gateway of your own: the SDK takes an empty
# value for a URL, not for unset, and every model call then fails.
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# --- The declarations repository ----------------------------------------------

# The repository every command reads when none is named with --repo and the
# current directory is not one. Absolute, or starting with ~. The alternative
# is `repo:` in ~/.config/idp-agent/config.yml.
# IDP_REPO=~/work/IaC

# --- A Backstage catalogue: read for questions, never for a change ------------------
# The catalogue API's base, never the app's URL: https://<backend host>/api/catalog.
# https:, or http: to 127.0.0.1, ::1 or localhost. The alternative is `backstage:` in
# ~/.config/idp-agent/config.yml; this one wins.
# IDP_BACKSTAGE_URL=http://127.0.0.1:7007/api/catalog
# A read token (docs/adopting-backstage.md). Required for any host but a loopback one;
# sent to that catalogue only, never into a file, a trace or a child process. Set, it is
# sent to a loopback host too, over plain http: unset it (env -u) for the local fake.
# IDP_BACKSTAGE_TOKEN=
# A read is kept five minutes under $XDG_CACHE_HOME/idp-agent/backstage (else
# ~/.cache/...), for your account only (SECURITY.md, "The kept catalogue"). off keeps
# nothing and is the one value: any other is refused, so a typo never keeps a copy.
# IDP_BACKSTAGE_CACHE=off

# --- Tracing: off unless one of these is set (SECURITY.md, "Traces") -----------

# Send one trace per model-backed run to this MLflow server. A trace carries
# the full prompts. MLflow's own MLFLOW_TRACKING_URI is never read.
# IDP_MLFLOW_TRACKING_URI=http://127.0.0.1:5055
# The MLflow experiment the trace goes to. 0 when unset.
# IDP_MLFLOW_EXPERIMENT_ID=0
# Or write one trace file per run into this directory, readable by you alone.
# Keep it out of the repository the Inspector reads, or in a hidden folder.
# IDP_TRACE_DIR=.traces

# --- Contributors only ----------------------------------------------------------

# "record" calls the real model with the key above and writes what it answered
# into tests/recordings. A deliberate act by a person with a key; the suite
# never sets it, and a run with it unset never writes a tape.
# IDP_RECORDING=
# The tape a recording is written to, when IDP_RECORDING=record.
# IDP_SCENARIO=
