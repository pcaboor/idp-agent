{
  "name": "idp-agent",
  "version": "0.1.0-rc.2",
  "description": "Turn a natural-language intent into reviewed infrastructure declarations",
  "license": "Apache-2.0",
  "author": "pcaboor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcaboor/idp-agent.git"
  },
  "homepage": "https://github.com/pcaboor/idp-agent#readme",
  "bugs": {
    "url": "https://github.com/pcaboor/idp-agent/issues"
  },
  "keywords": [
    "backstage",
    "catalog",
    "gitops",
    "platform-engineering",
    "idp",
    "infrastructure-as-code",
    "multi-agent",
    "llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "idp-agent": "dist/cli/bin.js",
    "idpa": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "fixtures",
    "templates",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:backstage": "node scripts/demo-backstage.mjs",
    "demo:backstage:docker": "node scripts/demo-backstage-docker.mjs",
    "backstage:up": "node scripts/backstage-compose.mjs up -d --build --wait",
    "backstage:down": "node scripts/backstage-compose.mjs down",
    "backstage:clean": "node scripts/backstage-compose.mjs down --rmi all",
    "prepack": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "mlflow:up": "docker compose -f tools/mlflow/compose.yml up -d --wait",
    "mlflow:down": "docker compose -f tools/mlflow/compose.yml down",
    "mlflow:contract": "node scripts/mlflow-contract.mjs",
    "trace:push": "node scripts/trace-push.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@ai-sdk/mistral": "4.0.48",
    "@ai-sdk/openai": "4.0.71",
    "ai": "7.0.107",
    "yaml": "^2.9.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
